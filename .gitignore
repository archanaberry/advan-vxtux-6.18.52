# Build artifacts that leaked in from device-synced trees (drivers/vxtux etc.)
# kbuild outputs *.o/*.ko/*.mod/.*.cmd in-tree when M= builds run on-device.
*.o
*.ko
*.mod
*.cmd
.*.cmd
*.mod.c
Module.symvers
modules.order
.tmp_versions/

# Tick/session backups and sync payloads - never belong in the tree.
*.bak_*
*.orig
*.bak
port_sync*.tar
tmp_build*.sh

# A device-sync leaked a second in-tree drivers/ at the repo root, a stale
# mirror of 6.18.52-VXTux-UMS512/drivers/ (1660 files).  Real sources live
# under 6.18.52-VXTux-UMS512/; a root-level one shadows nothing but gets swept
# into commits by `git add -A`.
/drivers/
tmp_build*.sh

# The stock vendor blobs ARE the ground truth for the deblob work: the
# symbol lists are diffed against them.  They must be tracked even though
# the build-artifact rule above says *.ko.
!donors/stock_vendor_modules/*.ko
!donors/stock_initramfs/*.ko

# The kernel-object tarballs are build payloads, not sources: 1.8 GB of
# them exceeded GitHub's 100 MB per-file limit and blocked every push.
donors/*.tar.gz

# The verifier reads the freshly built modules from here.  They are build
# output, not sources: 343 MB of .ko that would otherwise be committed and
# would break the 100 MB per-file push limit.
built_kos/

# Image flash (super 5,6 GB + boot.img) adalah hasil racikan, bukan sumber:
# jauh di atas batas 100 MB per-file GitHub.
out/**/*.img
out/**/Image
out/**/System.map
out/**/*.dtb
out/**/*.tar.gz
out/**/modules/**

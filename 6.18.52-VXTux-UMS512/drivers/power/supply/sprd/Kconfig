config CHARGER_SPRD_MANAGER
	tristate "Sprd Charger Manager for UMS512/T618"
	depends on OF && POWER_SUPPLY && REGMAP
	depends on MFD_SC27XX_PMIC
	# NO "select POWER_SUPPLY": this symbol already depends on POWER_SUPPLY,
	# and kconfig rejects a symbol that both selects and depends on the same
	# symbol ("recursive dependency detected"). This Kconfig file is sourced
	# from drivers/power/supply/Kconfig, so POWER_SUPPLY is already defined
	# and visible here; the depends-on is sufficient.
	select ALARM_TIMER
	default n
	help
	  Sprd Charger Manager for UMS512/T618 (sharkl5pro).
	  Ported from vendor blob sprd-charger-manager.ko (5.4.210).
	  Provides: CP state machine, fast charger, V-charger,
	  vote system, JEITA, UVLO, battery monitoring.
config SPRD_BATTERY_INFO
	tristate "Unisoc battery info DT table parser"
	depends on OF && POWER_SUPPLY
	default n
	help
	  Parses the Unisoc battery characteristic tables (OCV/capacity,
	  voltage/temperature, internal resistance, energy density, BASP, JEITA)
	  out of device tree, from the node pointed at by the "monitored-battery"
	  phandle of the fuel gauge. No MMIO access. Five EXPORT_SYMBOL_GPL,
	  identical to the vendor blob sprd_battery_info.ko.

	  Ported from drivers/power/supply/sprd_battery_info.c of the GPL donor
	  (951 lines, md5 identical between bocchi and marohinmark).

	  fgauge_get_profile_id() (battery profile index) is provided by
	  unisoc_battery_id.c — a port of the donor's unisoc_battery.c
	  detection path (ADC + NTC ranges). Without an io-channel "batt_id"
	  in DT, the donor's own fallback applies: profile 0 (single battery).

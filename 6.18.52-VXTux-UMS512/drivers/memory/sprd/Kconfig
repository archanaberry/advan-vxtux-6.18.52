config VXTUX_HYBRIDSWAP_REF
	tristate "VXTux: hybridswap (OPLUS) reference port (RE)"
	depends on SWAP && ZSMALLOC
	default n
	help
	  OPLUS hybridswap reference port (blob: hyb.o) — additional memory-management feature
	  NOT boot-critical. Blob broken in fork (struct #if conflicts,
	  proven Phase 9B) — this port cleans it up as living documentation.
	  Keep n unless researching UMS512 zram/zswap.

source "drivers/vxtux/usb/Kconfig"

# NPU/VDSP (2026-10-14): sprd_vdsp — donor 4.14 Cadence/XRP, firmware
# vdsp_firmware.bin. Menutup entry terakhir inventory103 (102 -> 103).
source "drivers/vxtux/npu/vdsp/Kconfig"

# Instrumen diagnostik boot (2026-10-26): perekam dmesg ke partisi cache.
# Dipakai untuk memburu boot yang menggantung sebelum userspace.
source "drivers/vxtux/debug/Kconfig"


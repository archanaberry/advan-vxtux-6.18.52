# CONFIG NOTE (18 Sep 2026): DRM_MIPI_DSI and DRM_KMS_HELPER are symbols
# HIDDEN (no prompt), so writing them directly in defconfig will be dropped
# by olddefconfig without message. VXTux Panel (DRM_PANEL_VXTUX_UMS512) depends on
# DRM_MIPI_DSI, so the DSI path must select it — not
# relying on defconfig.
#
# IMPORTANT: one `config` may only have ONE `help` block. Error
# "defined with more than one help text" appears in kconfig when second help block
# is added (happened 18 Sep 2026 and broke `make defconfig`).
config VXTUX_SPRD_DPU
	tristate "VXTux: sprd DPU/DRM consolidated patches (RE)"
	depends on DRM && DRM_SPRD
	select DRM_MIPI_DSI
	select DRM_KMS_HELPER
	default n
	help
	  Consolidation of proven build v4 patches: XR24/XB24 -> RB/UV switch,
	  primary-only plane guard, FBC enabled=0 sweep, fbdev generic setup.
	  Target: fork 5.4 patches moved to official structure + ready for 6.18 port.

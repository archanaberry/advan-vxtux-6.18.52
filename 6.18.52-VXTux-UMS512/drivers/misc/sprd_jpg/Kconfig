# Unisoc JPEG hardware codec driver (UMS512 / T618).
#
# Ported from the 5.4 donor work/donors_20260930/iscle_ums512.
# Needs the vendor IOMMU/ION helpers used by its JPG_GET_IOVA ioctl:
# CONFIG_SPRD_IOMMU and CONFIG_SPRD_ION. Without them both helper calls fall
# back to static inline stubs that return -ENODEV, and the ioctl degrades to
# -EOPNOTSUPP rather than working.
config SPRD_JPG
	tristate "Unisoc JPEG codec support"
	depends on HAS_IOMEM
	depends on COMMON_CLK
	select SPRD_IOMMU
	select SPRD_ION
	help
	  Support for the Unisoc (Spreadtrum) JPEG encoder/decoder hardware
	  block found on UMS512 (T618), Sharkl5Pro and relatives. It exposes
	  /dev/sprd_jpg, whose hardware registers userspace maps directly for
	  bitstream-level encode/decode, plus clock and QoS control ioctls.

	  Say Y here if you want to use the Unisoc JPEG codec, say N if you
	  do not want to use it.  If unsure, say N.
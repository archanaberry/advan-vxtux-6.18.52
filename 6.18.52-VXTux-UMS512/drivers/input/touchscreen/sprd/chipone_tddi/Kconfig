# touch/chipone_tddi/Kconfig — Chipone TDDI public (GPL)
# LinDroid/VXTux v1.0 — 2nd alternative TP (this device uses hx83102e;
# chipone = panel variant on other units / reference).
#
# Session 5: public source recovered from realme C30 fork (Android R, 35 files
# cts_* — Chipone Touch Solution). Old skeleton shim → attic/.
# Makefile upstream: obj-$(CONFIG_TOUCHSCREEN_CHIPONE) += chipone-tddi.o

config TOUCHSCREEN_CHIPONE
	tristate "Chipone TDDI touchscreen (VXTux reference)"
	depends on I2C && INPUT
	default n
	help
  Public chipone-tddi tree (cts_*). Not used on this T1030 unit
  (panel hx83102e) — built as reference/support other panel
  variants. DT compatible from stock blob: check blobs/re_notes/.

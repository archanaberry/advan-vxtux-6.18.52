# Unisoc/VXTux touch panels for UMS512 (T618). CONFIG_TOUCHSCREEN_SPRD is the
# aggregator referenced by drivers/Makefile
# (obj-$(CONFIG_TOUCHSCREEN_SPRD) += input/touchscreen/sprd/); it was
# referenced there but never defined, so neither touch driver was built.

config TOUCHSCREEN_SPRD
	bool
	default y
	help
	  Aggregator for the Unisoc/VXTux touch drivers. Not user-selectable;
	  select the panel driver you want below.

source "drivers/input/touchscreen/sprd/hx83102e/Kconfig"
source "drivers/input/touchscreen/sprd/chipone_tddi/Kconfig"

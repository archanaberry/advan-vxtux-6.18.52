config SPRD_TOP_DVFS
	tristate "Unisoc TOP DVFS devfreq driver"
	depends on PM_DEVFREQ && COMMON_CLK
	help
	  Hardware DVFS for the Unisoc T618 (UMS512) TOP domain. Replaces the
	  sprd-top-dvfs vendor blob.

config SPRD_APSYS_DVFS
	tristate "Unisoc apsys hardware DVFS driver"
	depends on PM_DEVFREQ
	help
	  Hardware DVFS gating for the Unisoc apsys blocks. One driver covering
	  three vendor blobs: apsys-dvfs, sprd_cp_dvfs and sprd_ddr_dvfs.

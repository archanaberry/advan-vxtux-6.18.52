CONFIG_DEFAULT_HOSTNAME="vxtux"

# gcc 15 (Alpine chroot) sangat ketat — warning jangan gagalkan build
# CONFIG_WERROR is not set

# --- ELF loader (WAJIB, hilang diam-diam saat regenerasi .config) ---
# CONFIG_BINFMT_ELF is not set di .config kb618 (2026-10-03). Gejalanya nyata
# dan fatal: kernel boot sampai "Run /init as init process" lalu
#   Failed to execute /init (error -8)   <- -8 = ENOEXEC
# lalu panic "No working init found". Kernel tanpa BINFMT_ELF tidak bisa
# menjalankan SATU PUN binary apa pun, jadi tidak hanya QEMU test yang mati:
# userspace Android mana pun akan gagal start. Bukan hanya limitasi QEMU.
# BUKAN bug Kconfig: fs/Kconfig.binfmt di tree ini identik dengan upstream
# 6.18 (BINFMT_ELF "default y", "depends on MMU", CONFIG_MMU=y), dan fragment
# ini tidak pernah menyebut BINFMT_ELF. Artifact lama yang sehat
# (device_artifacts/r9/.config:991 dan r10-qemu/.config:989) keduanya punya
# CONFIG_BINFMT_ELF=y + CONFIG_COMPAT_BINFMT_ELF=y. Jadi nilainya hilang saat
# .config di-regenerasi, bukan pernah salah tulis di fragment.
# Tulis eksplisit supaya merge_config tidak bisa mengabaikannya lagi.
CONFIG_BINFMT_ELF=y
CONFIG_COMPAT_BINFMT_ELF=y
# Script #!/bin/sh initramfs (busybox sh) juga butuh BINFMT_SCRIPT; tanpa ini
# /init shebang ditolak ENOEXEC meski ELF-nya ada. Keduanya belum aktif di
# .config kb618.
CONFIG_BINFMT_SCRIPT=y

# --- VXTux drivers (repo drivers/vxtux/) ---
CONFIG_VXTUX_DRIVERS=y
# GPU 6.18: PANFROST mainline = jalur utama (in-tree, G52 didukung, DT patch kecil).
# kbase DDK r34p0 (kirin mirror) = referensi ABI blob / opsi kompat — pending
# de-Huawei (9 file + header hilang). C21Y gondul = r27p0 (ABI mismatch, jangan).
# CONFIG_MALI_MIDGARD is not set
# CONFIG_MALI_PLATFORM_NAME is not set

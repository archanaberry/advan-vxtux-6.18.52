# --- Identitas ---
# uname -r = 6.18-VXTux-UMS512 (SUBLEVEL dikosongkan oleh integrate.sh)
CONFIG_LOCALVERSION="-VXTux-UMS512"
# AUTO=y menambahkan -g<hash> di pohon git — matikan agar nama deterministik

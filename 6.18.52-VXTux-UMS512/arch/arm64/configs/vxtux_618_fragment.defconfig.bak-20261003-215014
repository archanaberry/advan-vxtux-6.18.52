# ================================================================
# DE-BLOB ACTIVATION (2026-09-22) — nyalakan driver MAINLINE yang
# menganggur, bukan menulis port baru. Setiap gerbang `depends on`
# diverifikasi terhadap device.config dan compatible-string dibaca
# dari pohon 6.18 (bukan dari ingatan). Lihat docs/DEBLOB_STRATEGY.md.
# BATAS: ini bukti STATIK (gate_fragment) — belum build/insmod.
# ================================================================
# --- PRASYARAT (bukan opsional): bus ADI -------------------------
# `adi_bus` di arch/arm64/boot/dts/sprd/ums512.dtsi = "sprd,ums512-adi";
# SATU-SATUNYA driver yang mem-bind-nya = drivers/spi/spi-sprd-adi.c.
# Tanpa ini MFD_SC27XX_PMIC=y (sudah aktif) tak punya SPI master, sehingga
# FGU/charger/RTC/ADC/vibra/LED/poweroff SC27xx tidak pernah probe.
CONFIG_SPI_SPRD_ADI=y
# --- Anak MFD_SC27XX_PMIC=y (dependensi sudah terpenuhi) ---------
# CATATAN (terverifikasi 2026-09-23): node DTS sc2730.dtsi sudah menyebut
# efuse/adc/eic/regulator/hwspinlock, tapi TIDAK ADA satu pun yang punya
# `select` di Kconfig -> simbol-simbol ini WAJIB ditulis, kalau tidak nodenya
# mati total (dan probe ADC/FGU gagal karena `hwlocks`/`nvmem-cells`/gpio
# tidak bisa di-resolve).
CONFIG_HWSPINLOCK_SPRD=y
CONFIG_NVMEM_SC27XX_EFUSE=y
CONFIG_REGULATOR_SC2731=y
CONFIG_SC27XX_ADC=y
CONFIG_RTC_DRV_SC27XX=y
CONFIG_POWER_RESET_SC27XX=y
CONFIG_INPUT_SC27XX_VIBRA=y
CONFIG_LEDS_SC27XX_BLTC=y
CONFIG_LEDS_TRIGGER_PATTERN=y
# --- UMS512: compatible cocok PERSIS dengan driver mainline ------
CONFIG_PWM_SPRD=y
CONFIG_SPRD_DMA=y
# --- Crypto: dua algoritma generik yang masih diminta userspace -
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_TWOFISH=y
# SENGAJA TIDAK dinyalakan (alasan di docs/DEBLOB_STRATEGY.md):
#   PINCTRL_SPRD_SC9860 → generasi SC9860, bukan UMS512.
#   PINCTRL_SPRD        → simbol TERSEMBUNYI (tristate tanpa prompt): hidup
#                         hanya lewat `select` dari SC9860; menulisnya =y di
#                         fragmen tidak berpengaruh apa pun.
# --- Gerbang uji QEMU (qemu-system-aarch64 -M virt) -------------------------
# -M virt memakai UART PL011 (ttyAMA0) + GICv3 + PSCI; tanpa ini kernel stok
# SPRD tidak punya console di QEMU. Empat opsi ini tidak berpengaruh di device.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# RE reconstruction of sprd_power_manager.ko (vendor_ramdisk layer B)
# Modular: 19 ekspor RE (sprd_mpm_*/sprd_pms_*) tanpa satu pun konsumen di
# pohon (modules.dep blob menghubungkannya dari audio_sipc/spool/spipe yang
# belum diport) — aman dan paling berguna sebagai modul uji insmod.
CONFIG_SPRD_POWER_MANAGER=m

# --- B29 (2026-09-24): driver in-tree yang CONFIG-nya mati padahal NODE DT-nya
# sudah ada. Aturan DEBLOB_STRATEGY.md §4 dipakai apa adanya: "verifikasi
# compatible dulu, jangan asal nyalakan". Yang lolos uji itu hanya dua baris:
CONFIG_GPIO_SPRD=y
                                    #   == of_match gpio-sprd.c:265 (cocok)
                                    #   == of_match musb_sprd_vxtux.c:384 (cocok)
                                    #   dep: USB_MUSB_HDRC=y, OF=y, EXTCON=y (semua terpenuhi)
# --- PROPOSAL P-MUSBPIO-1 (disetujui pemilik 2026-09-25: opsi A "dua duanya") ---
# Perubahan : SATU baris di fragmen ini (bukan config device, bukan DTS).
# Alasan    : musb_core.c:2421-2426 menuntut .dma_init/.dma_exit saat
#             CONFIG_MUSB_PIO_ONLY tidak diset, sedangkan sprd_musb_ops
#             (musb_sprd_vxtux.c:263-271) tidak punya keduanya -> probe MUSB
#             gagal -ENODEV "DMA controller not set" SEBELUM sampai ke PHY.
#             Alternatif "nyalakan DMA" terbukti MUSTAHIL in-tree:
#             USB_INVENTRA_DMA hanya `depends on USB_MUSB_OMAP2PLUS ||
#             USB_MUSB_MEDIATEK || USB_MUSB_JZ4740 || USB_MUSB_POLARFIRE_SOC`
#             (musb/Kconfig), dan glue papan memakai USB_MUSB_SUNXI.
# PASS tanpa flash: `qemu_probe_map.py --usb-gate` berhenti melaporkan musb
#             sebagai kegagalan -ENODEV "DMA controller not set" pada Image
#             berikutnya (sekarang belum bisa dibangun — lihat BLOCKER B-A).
# FAIL      : errno sama muncul lagi di probe_map/insmod log.
# Rollback  : hapus baris di bawah (satu baris, tanpa jejak lain).
# Catatan   : PIO = tanpa DMA -> throughput turun, bukan risiko kebenaran.
#             Jalur DMA vendor (sprd_musbhsdma.c, register +0x1000) tetap
#             direncanakan sebagai opsi B dengan proposal terpisah, karena ia
#             berkas driver baru + mengubah `depends on` simbol DMA.
CONFIG_MUSB_PIO_ONLY=y

# SENGAJA DITAHAN — bukan lupa, dan bukan "murah": masing-masing gagal di uji
# "node DT + of_match dulu" sehingga menyalakannya hanya menghasilkan driver
# yang terbangun tetapi tidak pernah probe (dan angka C2 yang menipu):
#   SPI_SPRD             → tak ada node spi di DTS port (4 kemunculan "spi"
#                          hanyalah hwspinlock); of_match menunggu node
#                          "sprd,sc9860-spi" yang belum ditulis.
#   SPRD_WATCHDOG        → tak ada node wdt; sc2730.dtsi:31 secara sadar tidak
#                          menulis node untuk blok yang belum punya driver.
#   CHARGER_BQ256XX      → node i2c bq2560x (DT live: 4-006b) belum ada di DTS port.
#   PINCTRL_SPRD_SC9860  → of_match mainline HANYA "sprd,sc9860-pinctrl"
#                          (pinctrl-sprd-sc9860.c:934), sedangkan DT vendor memakai
#                          "sprd,pinctrl", dan DTS port belum punya node pinctrl:

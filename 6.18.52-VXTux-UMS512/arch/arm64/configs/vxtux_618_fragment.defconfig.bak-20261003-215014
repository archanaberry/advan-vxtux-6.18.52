# sama sekali walau baris =m ditulis. Karena itu keluarga ini dibangun
# built-in (=y); komentar "=m" di touch/hx83102e/Kconfig sudah dikoreksi.
CONFIG_TOUCHSCREEN_HIMAX_CHIPSET=y
CONFIG_TOUCHSCREEN_HIMAX_COMMON=y
CONFIG_TOUCHSCREEN_HIMAX_INCELL=y
CONFIG_TOUCHSCREEN_HIMAX_IC_HX83102=y
# chipone: TP alternatif (device ini Himax) — simbol internal (g_black_test,
# Ctp_name, irq_to_desc, dst.) tidak diekspor di 6.18 → modpost gagal.
# Nonaktif sampai port simbol selesai.
# CONFIG_TOUCHSCREEN_CHIPONE is not set

# --- Platform UNISOC in-tree (dari fork 5.4, port Fase 14) ---
CONFIG_ARCH_SPRD=y
CONFIG_SPRD_UMS512_CLK=y
# I2C controller SPRD (UMS512). Ditemukan 2026-10-03 dari .config:
#   "# CONFIG_I2C_SPRD is not set" -> kernel tidak punya adapter i2c SAMA SEKALI,
#   padahal bus touch i2c3@600000 ada di DTS dan himax i2c_driver sudah terdaftar.
#   Tanpa adapter, of_match_table himax tidak pernah bisa bind (tidak ada bus).
# i2c-sprd of_match HANYA "sprd,sc9860-i2c"; DTS board memakainya sebagai
# fallback. Depends on I2C=y && ARCH_SPRD && COMMON_CLK - ketiganya sudah ada.
# CATATAN: komentar ini dulu mengandung tanda kutip tunggal yang belum ditutup
# sehingga shell sempat melahap baris berikutnya (latent, bukan penyebab gagal).
CONFIG_I2C_SPRD=y
CONFIG_SPRD_IOMMU=m
# ION dihapus dari mainline — Waydroid pakai dma-heap (gralloc minigbm)
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_FUEL_GAUGE_SC27XX=y
CONFIG_CHARGER_MANAGER=m
# WCN_INTEG was disabled here since build #9 (2026-09-23) because boot/ defines
# the same globals as platform/. That is still true, but "disable" was the wrong
# lever: it left only platform/ builtin and the two stacks then had to coexist in
# vmlinux.a with platform/wcn_boot.o winning by link order. B is the actual fix --
# include/misc/marlin_platform.h is the contract 30 files include, and its
# signatures match platform/wcn_boot.c (start_marlin takes enum wcn_sub_sys) not
# the boot/ copies (u32). So platform/ is the correct implementation; boot/ is the
# divergent one. WCN_INTEG is now =m, which turns boot/ into its own .ko instead
# of forcing one of the two stacks to vanish.
CONFIG_WCN_INTEG=m
CONFIG_WCN_PLATFORM=m
CONFIG_WCN_SIPC=m
# The four above must all be =m. WCN_PLATFORM and WCN_SIPC depend on WCN_INTEG,
# so if either is =y, kconfig must promote WCN_INTEG to =y to keep the =y
# dependency valid, and boot/wcn_integrate*.o ends up in the same vmlinux.a as
# platform/wcn_boot.o -- 15 duplicate globals. Declared here, in the FIRST WCN
# block, because merge_config takes the earliest assignment.
CONFIG_WCN_CORE=m
CONFIG_WCN_BLUETOOTH=m
CONFIG_WCN_FM=m
CONFIG_UMW2652=m
CONFIG_UMW2653=m
CONFIG_WCN_BOOT=y
# WCN papan ini = SC2355 lewat SDIO (bukti: blob wcn_bsp.ko memuat string
# sdiohal_*; DTS device memuat "sprd,sc2355-sdio-wifi"). Jadi jalur benar =
# SC23XX + SDIOHAL + WCN_SLP.
# WCN_CORE = modul komposit inti platform/ (23 objek: power + bus SDIO + GNSS
# control) — dibuat modular agar bisa di-insmod/diuji satu per satu di QEMU.
# Pemilik bentuknya = wcn_integrate_boot.c versi blob SDIO (13 dari 20
# simbol duplikat punya salinan identik di platform/).
CONFIG_SC23XX=y
# SC2355 = pemilih header register chip (`#ifdef CONFIG_SC2355` di wcn_glb.h).
# Tanpa ini, chip glb header tidak ikut dan puluhan makro register hilang.
CONFIG_SC2355=y
CONFIG_SDIOHAL=y
CONFIG_WCN_SLP=y
# BT + FM: satu-satunya dua sub-simbol WCN yang dibangun sebagai MODUL, karena
# blob aslinya memang modul (sprdbt_tty.ko, sprd_fm.ko). Simbol dan nama modul
# diambil dari pohon dalam-tree referensi (drivers/wcn/Kconfig di
# gpl-source/hadenix_ums512_wcn), bukan dari Makefile vendor generasi-external.
# WCN_UTILS wajib: tanpa ini wcn_debugfs.o tak pernah dibangun dan ekspor blob
# `wcn_init_debugfs` hilang tanpa suara (lihat komentar platform/Kconfig).
CONFIG_WCN_UTILS=y
# CONFIG_WCN_SEC_VERIFY_STUB is not set (deviasi keamanan yang SENGAJA tidak
# diambil: verifikasi citra BTWF/GNSS tetap butuh TEE; tanpa simbol itu
# wcn_firmware_sec_verify() mengembalikan -EOPNOTSUPP sehingga citra bertanda
# tangan tidak dimuat).
CONFIG_DRM_SPRD=m

# --- P4/B13: rantai dependensi + seluruh driver port yang WAJIB dikompilasi ---
# Tanpa blok ini, olddefconfig membuang simbol driver vxtux secara diam-diam:
# SPRD_MAILBOX (default y) hanya hidup bila SPRD_MBOX && MAILBOX aktif,
# dan hampir semua driver port bergantung padanya (SIPC/audio/ASoC).
# Catatan: nama lama CONFIG_UNISOC_AUDIO_* tidak ada di Kconfig port
# (yang benar: CONFIG_SPRD_AUDIO_*) sehingga dulu tidak berefek.
# Mainline: mailbox Spreadtrum + dma/allocator pendukung
CONFIG_MAILBOX=y
CONFIG_SPRD_MBOX=y
CONFIG_SPRD_MAILBOX=y
# CONFIG_GENERIC_ALLOCATOR tidak ditulis: simbol HIDDEN (tanpa prompt) dan sudah
# di-`select` oleh ARM64, jadi baris eksplisit hanya menyesatkan (dibuang
# olddefconfig, nilai efektifnya tetap y). Dijaga gerbang D5 gate_fragment.py.
# ZSMALLOC adalah simbol HIDDEN (tanpa prompt) -> nilai yang ditulis langsung di
# sini SELALU dibuang olddefconfig (terbukti: buildd/.config memuat "(tidak ada)"
# untuk CONFIG_ZSMALLOC), dan akibatnya VXTUX_HYBRIDSWAP_REF ikut mati. Cara
# benar: nyalakan pemakainya — ZRAM mem-`select ZSMALLOC` (ZSWAP juga bisa).
CONFIG_ZRAM=y
# CONFIG_TRUSTY dibuang: 6.18 mainline tidak punya drivers/trusty (diverifikasi
# di pohon: direktori itu tidak ada, hanya drivers/tee), dan jalur trusty port
# hanya untuk DISP (CONFIG_VXTUX_TRUSTY_DISP) yang kini lepas dari simbol itu.
CONFIG_MFD_SC27XX_PMIC=y
# SOUND adalah INDUK dari SND/SND_SOC (menuconfig tristate). Dengan SOUND=m,
# CONFIG_SND=y turun diam-diam menjadi m (gerbang D2 gate_fragment). Dipatok y
# agar seluruh stack suara benar-benar built-in sesuai niat port ASoC.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# CONFIG_DRM_MIPI_DSI tidak ditulis: simbol HIDDEN, hidup lewat `select` dari
# VXTUX_SPRD_DPU (jalur DSI port) — bukan diandalkan dari defconfig (gerbang D5).
# SIPC (bus AP <-> CP/DSP) + anak-anaknya
CONFIG_SPRD_SIPC=y
# Mengapa inti SIPC TIDAK bisa =m (bukti scan call-graph 2026-09-23):
# agdsp_access (=y, dipakai sound ASoC =y) memanggil smsg_* dari smsg.c;
# audio-smsg.o hanya dibangun di bawah SPRD_AUDIO_SIPC (=y). =m di sini =
# vmlinux undefined symbol. Yang modular dari keluarga SIPC: SWCNBLK di bawah.
# SPRD_SIPC_{SPIPE,SPOOL,SETH} = transport MODEM (pipe/pool di atas sbuf/sblock,
# Ethernet-over-shared-memory) TANPA satu pun sumber di pohon ini: Kconfig-nya
# ada, tetapi nol arm Makefile dan nol rujukan .c/.h. Meng-`=y`-kannya adalah
# klaim palsu - build tetap 0 error HANYA karena kodenya tak pernah dikompilasi.
# Dimatikan 2026-09-22; gerbang `tools/re/audit_wiring.py` (kelas CONFIG-ZOMBIE)
# kini menolak bila dinyalakan lagi. Nyalakan kembali hanya bila source
# transport-nya benar-benar diporting (prioritas modem, sekarang P3/terakhir).
# CONFIG_SPRD_SIPC_SPIPE is not set
# CONFIG_SPRD_SIPC_SPOOL is not set
# CONFIG_SPRD_SIPC_SETH is not set
# SIPX zero-copy BELUM DIPORT (sipx.c tidak ada di pohon; sumbernya ada di
# gpl-source/fork_t618/.../drivers/soc/sprd/modem/sipc/sipx.c). Simbol ini =y
# sebelumnya membuat sipc_debugfs.o memanggil sipx_init_debugfs() yang tidak
# punya definisi -> ld.lld "undefined symbol" saat link vmlinux.
# CONFIG_SPRD_SIPC_ZERO_COPY_SIPX is not set
# SWCNBLK modular: konsumennya (wcn_sipc, lapisan integrate) tidak dibangun
# di papan SDIO ini, jadi transportnya aman di-insmod/diuji terpisah.
# Audio infra AGDSP/AGCP (port R1: agdsp_access + audio_sipc)
CONFIG_SPRD_AUDIO_INFRA=y
CONFIG_SPRD_AUDIO_MEMORY_MANAGER=y
CONFIG_SPRD_AUDIO_AGDSP_ACCESS=y
CONFIG_SPRD_AUDIO_SIPC=y
# SIPC audio TETAP =y: audio-smsg.o-nya adalah penyedia smsg_* untuk
# agdsp_access (=y) — rantai terpendek yang memaksa inti SIPC built-in.
# DSP_DUMP + SAUDIO modular: konsumen mereka hanya saling antar-berkas di
# dalam subtree audio (bukan sound =y), jadi aman jadi .ko untuk uji insmod.
CONFIG_SPRD_AUDIO_DSP_DUMP=m
CONFIG_SPRD_AUDIO_SAUDIO=m
CONFIG_SPRD_AUDIO_CPBOOT=y
CONFIG_SPRD_AUDIO_PIPE=y
CONFIG_SPRD_AUDIO_VOICE_TRIGGER=y
CONFIG_SPRD_AUDIO_MCDT=y
# MCDT varian hardware (choice di audio/mcdt/Kconfig). UMS512/T1030 memakai
# r1p0 (node DT "sprd,sharkl5-mcdt" cocok dengan mcdt_hw.c). Ditulis eksplisit
# supaya pilihan varian tidak bergantung pada `default` -- dan supaya gerbang
# bisa memverifikasi bahwa choice-nya benar-benar teresolusi.
CONFIG_SPRD_AUDIO_MCDT_R1P0=y
CONFIG_SPRD_HW_DEVICE_DVFS_AGCP=y
# ASoC port (vbc-v4 + sc2730 + routing + kartu)
# INDUK WAJIB: VXTUX_SND_SPRD_ASOC adalah menuconfig `default n` dan keenam
# anaknya berada di dalam `if VXTUX_SND_SPRD_ASOC` -> tanpa baris ini semuanya

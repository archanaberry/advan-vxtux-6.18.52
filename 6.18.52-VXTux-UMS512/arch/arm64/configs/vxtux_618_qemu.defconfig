#
# vxtux_618_qemu.defconfig - FRAGMEN VALIDASI QEMU (B31/H5, 2026-09-25)
#
# INI BUKAN pengganti vxtux_618_fragment.defconfig (produksi; JANGAN disentuh,
# lihat docs/SESSION_STATE.md §5). Berkas ini khusus untuk memvalidasi kernel
# yang sama di QEMU `-M virt` sebelum menyentuh hardware:
#   1. UDC sintetis (dummy_hcd) supaya jalur gadget/ttyGS0/FunctionFS bisa
#      diuji DI DALAM guest (QEMU tidak punya MUSB; host Windows tidak akan
#      melihat perangkat - batas ini ditulis di laporan readiness).
#   2. i2c-sprd ditambahkan node bus-nya di DTS (H6) -> driver perlu =y.
#   3. VIRTIO* sebenarnya sudah =y di r9; dicantumkan eksplisit supaya
#      fragment ini BERDIKIRI (fail-safe bila basis berubah).
#
# Semua simbol di bawah ada di Kconfig 6.18 pohon kita (dicek 2026-09-25):
#   drivers/usb/gadget/udc/Kconfig:428   USB_DUMMY_HCD
#   drivers/i2c/busses/Kconfig:1154      I2C_SPRD (r9 masih n -> H6)
#   drivers/usb/gadget/Kconfig           USB_CONFIGFS* (sudah y di r9)

# --- 1) UDC sintetis untuk QEMU -------------------------------------------
CONFIG_USB_DUMMY_HCD=y

# --- 2) i2c controller (DTS baru H6: i2c0/1/3/4 di 0x713/4/6/700000) -------
CONFIG_I2C_SPRD=y

# --- 3) rantai gadget yang diuji (idempoten dengan r9, ditegaskan) ---------
#  CATATAN gate_fragment (bukti, bukan gaya): USB_LIBCOMPOSITE, USB_F_FS dan
#  USB_F_ACM adalah simbol TANPA PROMPT - nilainya murni `select` dari
#  USB_CONFIGFS(_F_FS/_ACM). Menulisnya eksplisit membuat gerbang D5 HIDDEN
#  gagal, dan memang sia-sia: sudah terpilih otomatis.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_ACM=y

# --- 4) konsol QEMU via virtio-console (2026-10-24) ------------------------
#  Tree V17 tidak punya driver AMBA PL011 (docs/CI-KNOWN-DROPPED.txt), jadi
#  PL011 milik -M virt mustahil dipakai. Console tamu memakai hvc0 di atas
#  -device virtio-serial-pci + -device virtconsole (console=hvc0).
#  Dependensi sudah terpenuhi: VIRTIO=y, PCI=y, PCI_MSI=y, TTY=y;
#  VIRTIO_CONSOLE otomatis select HVC_DRIVER.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y

# --- 5) keyboard virtio untuk sesi CLI fbcon (2026-10-25) -------------------
#  Input core sudah =y di enhanced_config (CONFIG_INPUT, INPUT_EVDEV,
#  INPUT_KEYBOARD). Tanpa driver keyboard di guest, perintah HMP `sendkey`
#  QEMU tidak pernah sampai ke VT/tty1 sehingga sesi shell interaktif di
#  fbcon tidak bisa digerakkan dari CI. virtio-keyboard-pci dienumerasi
#  lewat node PCIe + ITS yang sama dengan virtio-gpu (tanpa perubahan DTS).
CONFIG_VIRTIO_INPUT=y

# --- 5) host PCIe generik (2026-10-24) ------------------------------------
#  DTB kustom qemu-ums512-t1030.dts kini memuat node pcie@10000000 (ECAM,
#  alamat persis QEMU -M virt base_memmap) + ITS GICv3 @0x8080000. Tanpa
#  host driver generik ini, -device virtio-serial-pci tidak terenumerasi
#  sehingga hvc0 (konsol tamu) tidak pernah ada pada boot DTB kustom.
CONFIG_PCI_HOST_GENERIC=y

# --- 6) fbcon / KMS via virtio-gpu (2026-10-24) -----------------------------
#  Check: "fbcon & DRM/KMS sudah bisa print CLI?" — sebelumnya TIDAK mungkin
#  di manapun: CONFIG_FB=n (enhanced_config baris 594), tak ada driver GPU
#  di QEMU (DRM_VIRTIO_GPU/BOCHS not set), FRAMEBUFFER_CONSOLE tak terdefinisi
#  (depends FB_CORE yang tak pernah ter-select). Rantai yang dinyalakan:
#  DRM_VIRTIO_GPU=y -> select DRM_CLIENT_SELECTION -> DRM_FBDEV_EMULATION=y
#  -> select FB_CORE (oleh DRM) -> FRAMEBUFFER_CONSOLE=y (default FBDEV).
#  VT_CONSOLE=y supaya printk boot ikut dirender fbcon (gaya Arch: teks
#  scrolling di layar) di samping hvc0. FONT sudah y dari basis.
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT_CONSOLE=y

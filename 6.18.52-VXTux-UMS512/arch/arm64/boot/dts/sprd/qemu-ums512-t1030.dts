// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * QEMU virt machine with UMS512/T1030 (Advan Tab VX Lite) peripherals
 *
 * This device tree provides a QEMU-bootable configuration using the standard
 * virt machine type, with UMS512-specific peripherals mapped to fixed addresses.
 * Hardware-specific registers are stubbed for QEMU emulation.
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "qemu,ums512-t1030", "qemu,virt";
	#address-cells = <2>;
	#size-cells = <2>;

	model = "QEMU UMS512/T1030 (Advan Tab VX Lite)";
	interrupt-parent = <&gic>;

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x80000000>; /* 2GB at 0x40000000 */
	};

	/* 8 cores: 4x Cortex-A75 + 4x Cortex-A55 */
	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0 0x0>;
			enable-method = "psci";
		};
		CPU1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0 0x100>;
			enable-method = "psci";
		};
		CPU2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0 0x200>;
			enable-method = "psci";
		};
		CPU3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0 0x300>;
			enable-method = "psci";
		};
		CPU4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x0 0x400>;
			enable-method = "psci";
		};
		CPU5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x0 0x500>;
			enable-method = "psci";
		};
		CPU6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x0 0x600>;
			enable-method = "psci";
		};
		CPU7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x0 0x700>;
			enable-method = "psci";
		};
	};

	/* PSCI for CPU power management */
	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	/* Generic timer */
	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_HIGH>;
		always-on;
	};

	/* GICv3 interrupt controller at standard virt location */
	gic: interrupt-controller@8000000 {
		compatible = "arm,gic-v3";
		reg = <0x0 0x8000000 0 0x10000>,   /* GICD */
		      <0x0 0x8010000 0 0x100000>,  /* GICR */
		      <0x0 0x8020000 0 0x10000>;   /* GICC/CPU interface */
		#interrupt-cells = <3>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		redistributor-stride = <0x0 0x20000>;
		#redistributor-regions = <1>;
		interrupt-controller;
		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
	};

	/* System control / global registers for clock gating */
	syscon: syscon@32070000 {
		compatible = "sprd,ums512-glbregs", "syscon", "simple-mfd";
		reg = <0x0 0x32070000 0 0x1000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0 0x32070000 0x1000>;

		/* Clock controller stub for QEMU */
		clk_ctrl: clock-controller@0 {
			compatible = "sprd,ums512-ap-clk";
			reg = <0x0 0x1000>;
			clocks = <&ext_26m>;
			clock-names = "ext-26m";
			#clock-cells = <1>;
		};
	};

	/* PL011 UART at 0x40200000 (console) */
	serial0: serial@40200000 {
		compatible = "arm,pl011", "arm,primecell";
		reg = <0x0 0x40200000 0 0x1000>;
		interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&uart0_clk>, <&uart0_clk>;
		clock-names = "uartclk", "apb_pclk";
		status = "okay";
	};

	/* Fixed 26MHz clock for UART and other peripherals */
	uart0_clk: uart0-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "uart0-clk";
	};

	ext_26m: clk-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "ext-26m";
	};

	/* MUSB USB OTG at 0x5FFF0000 */
	usb: usb@5fff0000 {
		compatible = "sprd,sharkl5pro-musb", "sprd,sharkl3-musb";
		reg = <0x0 0x5fff0000 0 0x2000>;
		interrupts = <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "mc";
		clocks = <&aonapb_gate 0>;
		clock-names = "core_clk";
		dr_mode = "peripheral";
		multipoint = "true";
		wakeup-source;
		status = "okay";

		/* Stub PHY for QEMU - will use dummy_hcd in kernel */
		usb-phy = <&hsphy>;
		phy-names = "usb";
	};

	/* USB PHY at 0x323B0000 - stub for QEMU */
	hsphy: hsphy@323b0000 {
		compatible = "sprd,sharkl5-phy", "sprd,sharkl5pro-phy";
		reg = <0x0 0x323b0000 0 0x1000>;
		sprd,syscon-enable = <&aon_apb_regs>;
		sprd,syscon-anag2 = <&anlg_phy_g2_regs>;
		vdd-supply = <&vddusb33>;
		sprd,vdd-voltage = <3050000>;
		extcon = <&extcon_usb>;
		#phy-cells = <0>;
		status = "okay";
	};

	/* AON APB registers for USB PHY enable */
	aon_apb_regs: syscon@327d0000 {
		compatible = "sprd,ums512-glbregs", "syscon", "simple-mfd";
		reg = <0x0 0x327d0000 0 0x3000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0 0x327d0000 0x3000>;

		aonapb_gate: clock-controller@0 {
			compatible = "sprd,ums512-aon-gate";
			reg = <0x0 0x3000>;
			clocks = <&ext_26m>;
			clock-names = "ext-26m";
			#clock-cells = <1>;
		};
	};

	/* Analog PHY G2 registers for USB PHY */
	anlg_phy_g2_regs: syscon@323b0000 {
		compatible = "sprd,ums512-glbregs", "syscon", "simple-mfd";
		reg = <0x0 0x323b0000 0 0x3000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0 0 0x323b0000 0x3000>;
	};

	/* EXTCON USB GPIO for VBUS detection */
	extcon_usb: extcon-gpio {
		compatible = "linux,extcon-usb-gpio";
		vbus-gpio = <&pmic_eic 0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	/* SC2730 PMIC at 0x32100000 (I2C 0x6B) - stubbed for QEMU */
	i2c0: i2c@32100000 {
		compatible = "sprd,ums512-i2c", "sprd,sc9860-i2c";
		reg = <0x0 0x32100000 0 0x100>;
		interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
		clock-frequency = <400000>;
		clocks = <&ext_26m>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		/* SC2730 PMIC on I2C bus at address 0x6B */
		sc2730_pmic: pmic@6b {
			compatible = "sprd,sc2730";
			reg = <0x6b>;
			spi-max-frequency = <26000000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			/* PMIC EIC (GPIO) for 3-button (power, vol+, vol-) */
			pmic_eic: gpio@280 {
				compatible = "sprd,sc2731-eic", "sprd,sc2730-eic";
				reg = <0x280>;
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				status = "okay";

				/* 3-button keys: power, vol+, vol- */
				power-key {
					compatible = "gpio-keys";
					#address-cells = <1>;
					#size-cells = <0>;
					status = "okay";

					power_button {
						label = "power";
						gpios = <&pmic_eic 0 GPIO_ACTIVE_LOW>;
						linux,code = <KEY_POWER>;
						wakeup-source;
					};
					vol_up_button {
						label = "vol-up";
						gpios = <&pmic_eic 1 GPIO_ACTIVE_LOW>;
						linux,code = <KEY_VOLUMEUP>;
					};
					vol_down_button {
						label = "vol-down";
						gpios = <&pmic_eic 2 GPIO_ACTIVE_LOW>;
						linux,code = <KEY_VOLUMEDOWN>;
					};
				};
			};

			/* PMIC ADC for thermal */
			pmic_adc: adc@504 {
				compatible = "sprd,sc2730-adc";
				reg = <0x504>;
				#io-channel-cells = <1>;
				status = "okay";
			};

			/* Type-C/extcon */
			sc27xx_typec: typec@380 {
				compatible = "sprd,sc2730-typec", "sprd,sc27xx-typec";
				reg = <0x380>;
				interrupt-parent = <&sc2730_pmic>;
				interrupts = <8>;
				sprd,mode = <2>;
				status = "okay";
			};

			/* Regulators */
			sc27xx-regulator {
				compatible = "sprd,sc2731-regulator", "sprd,sc2730-regulator";
				status = "okay";

				vddusb33: LDO_USB33 {
					regulator-name = "vddusb33";
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <3750000>;
					regulator-ramp-delay = <25000>;
				};
			};
		};
	};

	/* eMMC/SD at 0x70700000 (SDHCI) */
	sdhci0: mmc@70700000 {
		compatible = "sprd,sdhci-r11", "generic-sdhci";
		reg = <0x0 0x70700000 0 0x1000>;
		interrup

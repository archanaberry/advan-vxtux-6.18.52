#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/*
 * Spreadtrum SC2730 PMIC dts file — papan UMS512/T618 (advan,t1030)
 *
 * KENAPA BERKAS BARU, BUKAN `#include "sc2731.dtsi"`:
 * papan ini memakai SC2730, dan ALAMAT setiap anak PMIC-nya berbeda dari
 * sc2731 (rtc 0x200 vs 0x280, eFuse 0x300 vs 0x380, ADC 0x504 vs 0x480,
 * FGU 0xc00 vs 0xa00, EIC 0x280 vs 0x300, BLTC 0x180 vs 0x200, vibrator
 * 0x1b90 vs 0xec8). Memasang sc2731.dtsi akan membuat driver membaca
 * register yang salah.
 *
 * SUMBER ANGKA: dump FDT kernel stok yang sedang berjalan
 * (`blobs/fdt_live.dtb`) lewat `tools/re/re_fdt_pmic.py --full`, bukan
 * salinan/dokumen. Ringkasan bukti: `docs/pmic_sc2730.md`.
 * Bus ADI-nya SAMA dengan mainline: ums512.dtsi punya
 * `aon@32000000 { adi_bus: spi@100000 {...} }` => 0x32100000, dan DTB stok
 * memuat `/soc/aon/spi@32100000` — alamat identik.
 *
 * CATATAN BINDING (penting, belum diuji boot):
 *  - adc/efuse/vibrator/rtc/bltc/eic/mfd cocok lewat `compatible`
 *    (rtc & bltc perlu entri `sprd,sc2730-*` yang ditambahkan di driver).
 *  - regulator & poweroff TIDAK punya of_match_table di mainline; keduanya
 *    dicocokkan lewat NAMA driver (`sc27xx-regulator`, `sc27xx-poweroff`),
 *    sehingga node-nya sengaja dinamai persis seperti itu. Inilah kenapa
 *    namanya bukan `power-controller@1800` / `poweroff@1820` seperti di DTS
 *    vendor.
 *  - tsensor/pd/smpl/watchdog/7sreset belum punya driver mainline,
 *    jadi sengaja tidak ditulis di sini (jangan bikin node yang menggantung).
 *  - B40 (2026-09-26): typec@380 MASUK — driver-nya kini ada
 *    (drivers/vxtux/usb/sc27xx_typec.c, RE port dari blob vendor).
 *    Angka 1:1 dari FDT stok (blobs/fdt_live.dtb):
 *    /soc/aon/spi@32100000/pmic@0/typec@380 — reg <0x380>,
 *    interrupt-parent pmic, interrupts <8>, sprd,mode <2>,
 *    nvmem-cells calib@d1 (0x1a 0x2) & calib@d2 (0x1a 0x2) dengan
 *    nama "typec_cc1_cal;typec_cc2_cal". Node dibiarkan status "okay"
 *    implisit? TIDAK — status disabled secara default dan dinyalakan
 *    di board dts, supaya dtsi tetap netral seperti node lain.
 */

&adi_bus {
	sc2730_pmic: pmic@0 {
		compatible = "sprd,sc2730";
		reg = <0>;
		spi-max-frequency = <26000000>;
		interrupts = <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		pmic_adc: adc@504 {
			compatible = "sprd,sc2730-adc";
			reg = <0x504>;
			interrupt-parent = <&sc2730_pmic>;
			interrupts = <0>;
			#io-channel-cells = <1>;
			hwlocks = <&hwlock 4>;
			nvmem-cell-names = "big_scale_calib", "small_scale_calib";
			nvmem-cells = <&adc_big_scale>, <&adc_small_scale>;
		};

		efuse@300 {
			compatible = "sprd,sc2730-efuse";
			reg = <0x300>;
			#address-cells = <1>;
			#size-cells = <1>;
			hwlocks = <&hwlock 12>;

			fgu_calib: calib@6 {
				reg = <0x6 0x2>;
				bits = <0 9>;
			};

			/* B40: kalibrasi trim Type-C (FDT stok: calib@d1 dan
			 * calib@d2, keduanya reg <0x1a 0x2>) */
			typec_cc1_cal: calib@d1 {
				reg = <0x1a 0x2>;
			};

			typec_cc2_cal: calib@d2 {
				reg = <0x1a 0x2>;
			};

			adc_big_scale: calib@24 {
				reg = <0x24 0x2>;
			};

			adc_small_scale: calib@26 {
				reg = <0x26 0x2>;
			};
		};

		pmic_eic: gpio@280 {
			compatible = "sprd,sc2731-eic", "sprd,sc2730-eic";
			reg = <0x280>;
			interrupt-parent = <&sc2730_pmic>;
			interrupts = <4>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		rtc@200 {
			compatible = "sprd,sc2731-rtc", "sprd,sc2730-rtc";
			reg = <0x200>;
			interrupt-parent = <&sc2730_pmic>;
			interrupts = <1>;
		};

		led-controller@180 {
			compatible = "sprd,sc2730-bltc";
			reg = <0x180>;
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				label = "red";
				reg = <0x0>;
			};

			led@1 {
				label = "green";
				reg = <0x1>;
			};

			led@2 {
				label = "blue";
				reg = <0x2>;
			};
		};

		vibrator@1b90 {
			compatible = "sprd,sc2730-vibrator";
			reg = <0x1b90>;
		};

		/*
		 * B45-fix4 (2026-09-27): PMIC global syscon — node yang HILANG dari
		 * sumber kanonik ini padahal konsumennya sudah ada di pohon.
		 *
		 * Provenance (bukan tebakan):
		 *   - FDT stok work/stock_dt/base_vendor_boot.dtb memuat KEDUA string
		 *     compatible di bawah (grep -aoc: "sc2731-syscon"=1,
		 *     "sc27xx-syscon"=1) — jadi node ini milik papan ini.
		 *   - Konsumen di pohon lewat of_match/of_find_compatible_node:
		 *       drivers/vxtux/soc/pmic_syscon/sprd_pmic_syscon.c:152
		 *       drivers/vxtux/net/wireless/sprdwcn/platform/wcn_boot.c:932
		 *       .../platform/gnss/gnss_common_ctl.c:250
		 *   - Kontrak driver (sprd_pmic_glb_probe, berkas di atas):
		 *       dev_get_regmap(dev->parent, NULL)  -> WAJIB anak PMIC (ya);
		 *       of_property_read_u32_index(np, "reg", 0, &base)
		 *                                          -> cell 0 = base register.
		 *     Karena itu 0x1800 yang dilaporkan sysfs berasal dari cell 0.
		 *   - reg tiga cell <0x1800 0x1ba0 0x1b98> disalin apa adanya dari FDT
		 *     stok. Driver hanya membaca cell 0; dua sel sisanya bagian skema
		 *     vendor (0x1b90 vibrator / 0x1b98 / 0x1ba0 semuanya offset PMIC).
		 *
		 * Mengapa penting: node ini dulu HANYA ada di salinan pohon
		 * (arch/arm64/boot/dts/sprd/sc2730.dtsi), sedangkan sumber kanonik =
		 * berkas INI. Gerbang T38b menangkapnya ("salinan panggung lebih baru
		 * dari sumbernya") — artinya sync berikutnya MENGHAPUS node itu dari
		 * pohon dan driver pmic_syscon + konsumen WCN/GNSS kehilangan regmap
		 * TANPA satu pun build gagal. Perbaikan = pindahkan ke sumbernya,
		 * bukan menambal pohon.
		 */
		syscon@1800 {
			compatible = "sprd,sc2731-syscon", "sprd,sc27xx-syscon";
			reg = <0x1800 0x1ba0 0x1b98>;
		};

		/*
		 * B40 (2026-09-26): Type-C DRP di PMIC — node replika FDT stok
		 * (angka lihat kepala berkas). Driver: drivers/vxtux/usb/
		 * sc27xx_typec.c. EFuse calib@d1/d2 = dua cell yang dirujuk
		 * FDT stok (keduanya 0x1a 0x2; catatan FDT live: dua node
		 * berbeda phandle, reg identik — direplika apa adanya).
		 */
		sc27xx_typec: typec@380 {
			compatible = "sprd,sc2730-typec", "sprd,sc27xx-typec";
			reg = <0x380>;
			interrupt-parent = <&sc2730_pmic>;
			interrupts = <8>;
			sprd,mode = <2>;
			nvmem-cell-names = "typec_cc1_cal", "typec_cc2_cal";
			nvmem-cells = <&typec_cc1_cal>, <&typec_cc2_cal>;
			status = "okay";
		};

		pmic_fgu: fgu@c00 {
			compatible = "sprd,sc2730-fgu";
			reg = <0x0c00>;
			bat-detect-gpio = <&pmic_eic 3 GPIO_ACTIVE_HIGH>;
			io-channels = <&pmic_adc 0>, <&pmic_adc 14>;
			io-channel-names = "bat-temp", "charge-vol";
			nvmem-cell-names = "fgu_calib";
			nvmem-cells = <&fgu_calib>;
			interrupt-parent = <&sc2730_pmic>;
			interrupts = <3>;
			status = "disabled";
		};

		/*
		 * Regulator SC2730. ATURAN (terverifikasi 2026-09-23): nama anak node
		 * HARUS sama dengan `of_match` di tabel `regulators[]` driver mainline
		 * (drivers/regulator/sc2731-regulator.c) — itulah yang dicocokkan
		 * of_get_regulator_init_data(). DTB stok memakai kosakata sendiri
		 * (DCDC_CORE, LDO_VDDCAMA0, ...) yang tidak cocok dengan satu pun nama
		 * driver, sehingga 32 rail "terpasang" tapi nol init data (always-on
		 * ikut hilang -> rail bisa dimatikan regulator core di late_initcall).
		 *
		 * Karena itu hanya rail yang DIKENAL driver yang ditulis di sini
		 * (17 = seluruh isi tabel driver). Rail vendor lain (DCDC_GEN0/1,
		 * DCDC_MEMQ/MODEM/SRAM, LDO_VDD28, LDO_AVDD12/18, LDO_VDD18_DCXO,
		 * LDO_VDDRF18, LDO_VDDRF1V25, LDO_VDDLDO0/1/2, LDO_VDDWCN,
		 * LDO_VDDSIM2, LDO_VDDKPLED) tidak punya driver di 6.18; tabel lengkap
		 * (nama + rentang voltase dari FDT stok) ada di docs/pmic_sc2730.md.
		 *
		 * Nama node ini sendiri bebas: driver sekarang punya of_match_table
		 * (ditambahkan 2026-09-23) sehingga bind lewat compatible
		 * "sprd,sc2731-regulator"/"sprd,sc2730-regulator".
		 */
		sc27xx-regulator {
			compatible = "sprd,sc2731-regulator", "sprd,sc2730-regulator";

			BUCK_CPU0 {
				/* padanan rail vendor belum terbukti; vendor menandai SEMUA 9 rail DCDC always-on */
				regulator-always-on;
			};

			BUCK_CPU1 {
				/* idem BUCK_CPU0 */
				regulator-always-on;
			};

			BUCK_RF {
				/* idem BUCK_CPU0 */
				regulator-always-on;
			};

			vddcama0: LDO_CAMA0 {
				/* DTB stok: LDO_VDDCAMA0 */
				regulator-name = "vddcama0";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				regulator-ramp-delay = <25000>;
			};

			vddcama1: LDO_CAMA1 {
				/* DTB stok: LDO_VDDCAMA1 */
				regulator-name = "vddcama1";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				regulator-ramp-delay = <25000>;
			};

			vddcamd0: LDO_CAMD0 {
				/* DTB stok: LDO_VDDCAMD0 */
				regulator-name = "vddcamd0";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-ramp-delay = <25000>;
			};

			vddcamd1: LDO_CAMD1 {
				/* DTB stok: LDO_VDDCAMD1 (min vendor 900000 di-clip ke min driver) */
				regulator-name = "vddcamd1";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1365000>;
				regulator-ramp-delay = <25000>;
			};

			vddcamio: LDO_CAMIO {
				/* DTB stok: LDO_VDDCAMIO (max vendor 1830000 di-clip ke max driver) */
				regulator-name = "vddcamio";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1793750>;
				regulator-ramp-delay = <25000>;
			};

			vddcammot: LDO_CAMMOT {
				/* DTB stok: LDO_VDDCAMMOT (rail fixed-voltage) */
				regulator-name = "vddcammot";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-ramp-delay = <25000>;
			};

			LDO_CON {
				/* padanan rail vendor belum terbukti */
			};

			LDO_EMMCCORE {
				/* DTB stok: LDO_VDDEMMCCORE */
				regulator-name = "vddemmccore";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				regulator-ramp-delay = <25000>;
				regulator-boot-on;
				regulator-always-on;
			};

			LDO_SDCORE {
				/* DTB stok: LDO_VDDSDCORE */
				regulator-name = "vddsdcore";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				regulator-ramp-delay = <25000>;
			};

			LDO_SDIO {
				/* DTB stok: LDO_VDDSDIO */
				regulator-name = "vddsdio";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				regulator-ramp-delay = <25000>;
			};

			LDO_SRAM {
				/* always-on: preseden sc2731.dtsi upstream */
				regulator-always-on;
			};

			/* Label `vddusb33` ditambahkan 2026-09-25 (F3): node hsphy USB
			 * menunjuk rail ini lewat vdd-supply = <&vddusb33> (stok: phandle
			 * 0x126 = LDO_VDDUSB33). Label tidak mengubah binding apa pun —
			 * driver SC27xx regulator mencocokkan lewat nama node/rail. */
			vddusb33: LDO_USB33 {
				/* DTB stok: LDO_VDDUSB33 */
				regulator-name = "vddusb33";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				regulator-ramp-delay = <25000>;
			};

			LDO_VLDO {
				/* padanan rail vendor belum terbukti */
			};

			LDO_WIFIPA {
				/* DTB stok: LDO_VDDWIFIPA */
				regulator-name = "vddwifipa";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3750000>;
				regulator-ramp-delay = <25000>;
			};
		};

		/*
		 * Power-off PMIC. Compatible = yang dipakai DTB stok device
		 * (sprd,sc27xx-poweroff | sprd,sc2730-poweroff). Driver 6.18 hanya
		 * punya .name, jadi tanpa of_match_table (ditambahkan 2026-09-23)
		 * node ini tidak akan pernah bind. Regmap diambil dari
		 * dev_get_regmap(parent), jadi tidak butuh `reg`/mfd_cell.
		 */

		sc27xx-poweroff {
			compatible = "sprd,sc27xx-poweroff", "sprd,sc2730-poweroff";
		};
	};
};
